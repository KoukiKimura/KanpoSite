# ==============================================================
# デプロイ用環境変数 (git 非管理 - .gitignore で除外済み)
# ==============================================================

# FTP サーバーホスト名
DEPLOY_FTP_HOST=www337.conoha.ne.jp

# FTP ユーザー名
DEPLOY_FTP_USER=root@pengin24.com

# FTP パスワード
DEPLOY_FTP_PASSWORD=CreativeDreamer24!

# FTP ポート（省略時: 21）
DEPLOY_FTP_PORT=21

# アップロード先リモートディレクトリ
DEPLOY_REMOTE_DIR=/public_html/pengin24.conohawing.com/site_mock

# デプロイ完了時に表示するサイト URL
DEPLOY_SITE_URL=https://pengin24.conohawing.com/site_mock
