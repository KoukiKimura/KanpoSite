# Shopify local environment template.
# Copy to env/shopify/.env.local and fill values locally.

# myshopify.com domain, for example: example-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront / catalog API token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_CATALOG_API_KEY=

# Optional. Required only for Admin GraphQL API automation.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_DEV_CLIENT_ID=
SHOPIFY_DEV_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04

# Optional. Required only for Shopify CLI theme push/pull without interactive login.
SHOPIFY_THEME_ACCESS_DEVELOPER_NAME=
SHOPIFY_THEME_ACCESS_DEVELOPER_EMAIL=
SHOPIFY_THEME_ACCESS_PASSWORD=
SHOPIFY_CLI_THEME_TOKEN=
SHOPIFY_THEME_ID=
