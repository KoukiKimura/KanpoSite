{% liquid
  assign fallback_title = title | default: 'ドクダミとトウキのお茶'
  assign fallback_type = type | default: 'お茶'
  assign fallback_price = price | default: '¥1,500'
  assign fallback_variant = variant | default: 'card'
  assign fallback_class = 'product-card product-card--' | append: fallback_variant
  assign fallback_url = fallback_url | default: url | default: routes.all_products_collection_url
%}

<article class="{{ fallback_class }}">
  <a class="product-card__media image-frame" href="{{ fallback_url }}" aria-label="{{ fallback_title | escape }}">
    {% render 'asset-or-image',
      fallback_asset: fallback_asset,
      alt: fallback_title,
      sizes: '(max-width: 639px) 100vw, (max-width: 1099px) 50vw, 33vw'
    %}
    <span class="product-card__badge">NEW</span>
  </a>
  <div class="product-card__content">
    {% if fallback_variant == 'simple' %}
      <h3 class="product-card__title">
        <a href="{{ fallback_url }}">{{ fallback_title }}</a>
      </h3>
    {% else %}
      <div class="product-card__meta">
        <div>
          {% if fallback_variant == 'card' %}
            <p class="eyebrow">{{ fallback_type }}</p>
          {% endif %}
          <h3 class="product-card__title">
            <a href="{{ fallback_url }}">{{ fallback_title }}</a>
          </h3>
        </div>
        <p class="price">{{ fallback_price }}</p>
      </div>
      {% if fallback_variant == 'card' %}
        <a class="link-underline" href="{{ fallback_url }}">{{ 'general.read_more' | t }} <span aria-hidden="true">&rarr;</span></a>
        <div class="product-card__purchase">
          <p class="stock-label">在庫あり</p>
        </div>
      {% endif %}
    {% endif %}
  </div>
</article>
