[
  {
    "name": "theme_info",
    "theme_name": "Shikoku Botanica Shopify",
    "theme_version": "0.1.0",
    "theme_author": "KanpoSite",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "ブランド",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "ロゴ画像"
      },
      {
        "type": "text",
        "id": "brand_kicker",
        "label": "ブランド肩書き",
        "default": "四国の植物と古民家の暮らし"
      },
      {
        "type": "text",
        "id": "brand_name_ja",
        "label": "ブランド名",
        "default": "四国ボタニカ"
      },
      {
        "type": "text",
        "id": "brand_name_en",
        "label": "英字ブランド名",
        "default": "Shikoku Botanica"
      },
      {
        "type": "textarea",
        "id": "footer_lead",
        "label": "フッター説明",
        "default": "四国の植物・薬草の背景を大切に、イヌトウキ茶、当帰粉末、苗、古民家滞在をご案内します。"
      }
    ]
  },
  {
    "name": "色",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "背景",
        "default": "#f4efe6"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "紙色",
        "default": "#fbf8f1"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "本文",
        "default": "#1d241c"
      },
      {
        "type": "color",
        "id": "color_moss",
        "label": "MOSS",
        "default": "#41543b"
      },
      {
        "type": "color",
        "id": "color_olive",
        "label": "OLIVE",
        "default": "#6d7b52"
      },
      {
        "type": "color",
        "id": "color_earth",
        "label": "EARTH",
        "default": "#8f6949"
      },
      {
        "type": "color",
        "id": "color_sand",
        "label": "SAND",
        "default": "#d9c6ad"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "罫線",
        "default": "#d8cfbf"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "補助テキスト",
        "default": "#6f6a5d"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "金茶",
        "default": "#ad8b57"
      }
    ]
  },
  {
    "name": "ナビゲーション",
    "settings": [
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "ヘッダーメニュー",
        "default": "main-menu"
      },
      {
        "type": "link_list",
        "id": "footer_menu",
        "label": "フッターメニュー",
        "default": "footer"
      }
    ]
  },
  {
    "name": "連絡先・SNS",
    "settings": [
      {
        "type": "text",
        "id": "contact_email",
        "label": "メールアドレス"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "電話番号"
      },
      {
        "type": "url",
        "id": "line_url",
        "label": "LINE URL"
      },
      {
        "type": "url",
        "id": "facebook_url",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "instagram_url",
        "label": "Instagram URL"
      }
    ]
  },
  {
    "name": "SEO・構造化データ",
    "settings": [
      {
        "type": "image_picker",
        "id": "default_og_image",
        "label": "デフォルトOGP画像"
      },
      {
        "type": "text",
        "id": "default_og_asset",
        "label": "デフォルトOGPアセットファイル名",
        "default": "home-hero-satoyama.webp"
      },
      {
        "type": "text",
        "id": "default_og_alt",
        "label": "デフォルトOGP画像alt",
        "default": "四国ボタニカの植物と古民家の風景"
      },
      {
        "type": "text",
        "id": "google_site_verification",
        "label": "Google Search Console 確認コード（metaタグのcontent値のみ）"
      },
      {
        "type": "text",
        "id": "ga4_measurement_id",
        "label": "Google Analytics 4 測定ID（例: G-XXXXXXXXXX）"
      },
      {
        "type": "text",
        "id": "organization_name",
        "label": "Organization名",
        "default": "四国ボタニカ"
      },
      {
        "type": "textarea",
        "id": "organization_description",
        "label": "Organization説明",
        "default": "イタリア語の botanica（ボタニカ。「植物・植物学」）にちなみ、四国の植物、薬草、イヌトウキの商品と喜多灘の古民家滞在をご案内するブランドです。"
      }
    ]
  }
]
