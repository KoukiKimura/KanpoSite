      },
      {
        "type": "text",
        "id": "default_og_alt",
        "label": "デフォルトOGP画像alt",
        "default": "里山と古民家のある山草のめぐみの風景"
      },
      {
        "type": "text",
        "id": "organization_name",
        "label": "Organization名",
        "default": "山草のめぐみ"
      },
      {
        "type": "textarea",
        "id": "organization_description",
        "label": "Organization説明",
        "default": "里山の草木と古民家の暮らしから生まれる養生の商品と滞在を届けるブランドです。"
      }
    ]
  }
]
