{% liquid
  assign access_text = section.settings.access_text
  if page != blank and page.metafields.custom.access_text != blank
    assign access_text = page.metafields.custom.access_text | metafield_tag
  endif

  assign map_embed_url = section.settings.map_embed_url | default: 'https://www.google.com/maps?q=799-3411%20%E6%84%9B%E5%AA%9B%E7%9C%8C%E5%A4%A7%E6%B4%B2%E5%B8%82%E9%95%B7%E6%B5%9C%E7%94%BA%E4%BB%8A%E5%9D%8A1154&output=embed'
  assign map_link_url = section.settings.map_link_url | default: 'https://www.google.com/maps/search/?api=1&query=%E6%84%9B%E5%AA%9B%E7%9C%8C%E5%A4%A7%E6%B4%B2%E5%B8%82%E9%95%B7%E6%B5%9C%E7%94%BA%E4%BB%8A%E5%9D%8A1154'
%}

<section class="section section-soft">
  <div class="shell story-panel">
    <div>
      <p class="eyebrow">Access</p>
      <h2 class="heading-serif section-heading">{{ section.settings.title }}</h2>
      <div class="rte">{{ access_text }}</div>
    </div>
    <div class="access-stack">
      <div class="card access-notes">
      <h3 class="heading-serif" style="font-size: 1.8rem;">ご案内</h3>
      <ul class="note-list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {% endfor %}
      </ul>
      </div>

      {% if map_embed_url != blank %}
        <div class="card access-map">
          <iframe
            title="{{ section.settings.map_title | default: 'Google Map' | escape }}"
            src="{{ map_embed_url | escape }}"
            width="600"
            height="420"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a class="link-underline access-map__link" href="{{ map_link_url | escape }}" target="_blank" rel="noopener noreferrer">
            Google Mapで見る
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "古民家アクセス",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "アクセス"
    },
    {
      "type": "textarea",
      "id": "access_text",
      "label": "アクセス本文",
      "default": "所在地、駐車場、最寄り駅からの案内は、予約確定時に個別にご案内します。"
    },
    {
      "type": "text",
      "id": "map_title",
      "label": "Google Map title",
      "default": "古民家アクセス Google Map"
    },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "Google Map embed URL",
      "default": "https://www.google.com/maps?q=799-3411%20%E6%84%9B%E5%AA%9B%E7%9C%8C%E5%A4%A7%E6%B4%B2%E5%B8%82%E9%95%B7%E6%B5%9C%E7%94%BA%E4%BB%8A%E5%9D%8A1154&output=embed"
    },
    {
      "type": "text",
      "id": "map_link_url",
      "label": "Google Map link URL",
      "default": "https://www.google.com/maps/search/?api=1&query=%E6%84%9B%E5%AA%9B%E7%9C%8C%E5%A4%A7%E6%B4%B2%E5%B8%82%E9%95%B7%E6%B5%9C%E7%94%BA%E4%BB%8A%E5%9D%8A1154"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "案内",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "本文",
          "default": "チェックイン時間は事前にご相談ください。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "古民家アクセス"
    }
  ]
}
{% endschema %}
