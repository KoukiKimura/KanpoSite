{% liquid
  assign featured_collection = collections[section.settings.collection]
  assign product_limit = section.settings.product_limit
%}

<section class="section section-soft">
  <div class="shell products-layout">
    <div class="products-copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="heading-serif section-heading">{{ section.settings.title }}</h2>
      <div class="section-body">{{ section.settings.text }}</div>
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <p>
          <a class="button button-secondary" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label }}
            <span aria-hidden="true">→</span>
          </a>
        </p>
      {% endif %}
    </div>

    <div class="product-grid product-grid--simple{% if product_limit > 3 %} product-grid--dense{% endif %}">
      {% if featured_collection != blank and featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: product_limit %}
          {% render 'product-card', product: product, variant: 'simple', show_quick_add: false %}
        {% endfor %}
      {% else %}
        {% render 'fallback-product-card',
          variant: 'simple',
          fallback_asset: 'srs-product-touki-powder.jpg',
          fallback_url: '/products/inutouki-tea-powder',
          type: '粉末',
          title: 'イヌトウキ茶（粉末）',
          price: '¥2,500',
          text: '生活習慣の考え方に寄り添う粉末タイプです。'
        %}
        {% render 'fallback-product-card',
          variant: 'simple',
          fallback_asset: 'srs-product-touki-teabag.jpg',
          fallback_url: '/products/inutouki-tea-teabag',
          type: 'お茶',
          title: 'イヌトウキ茶（茶葉ティーバッグ）',
          price: '¥1,500',
          text: '1袋ずつ扱いやすい当帰茶のティーバッグタイプです。'
        %}
        {% render 'fallback-product-card',
          variant: 'simple',
          fallback_asset: 'srs-touki-p.jpg',
          fallback_url: '/products/touki-powder',
          type: '粉末',
          title: '当帰粉末',
          price: '¥3,000',
          text: 'ヒュウガトウキの茎と葉を粉末にした商品です。'
        %}
        {% render 'fallback-product-card',
          variant: 'simple',
          fallback_asset: 'srs-inutouki-2022.jpg',
          fallback_url: '/products/inutouki-seedling',
          type: '苗',
          title: 'イヌトウキ苗',
          price: 'お問い合わせ',
          text: 'Angelica shikokiana Makino の苗を予約・問い合わせ品としてご案内します。'
        %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "注目商品",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "肩書き",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "商品"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "本文",
      "default": "生活習慣への向き合い方をもとに、イヌトウキ茶、ドクダミとトウキのお茶、当帰粉末、イヌトウキ苗をご案内します。"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "表示するコレクション"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "表示件数",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "商品カードにカート追加を表示",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTAラベル",
      "default": "商品一覧へ"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTAリンク"
    }
  ],
  "presets": [
    {
      "name": "注目商品"
    }
  ]
}
{% endschema %}
