<section class="section">
  <div class="shell">
    <div style="max-width: 760px; margin-bottom: 32px;">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="heading-serif section-heading">{{ section.settings.title }}</h2>
      <p class="section-body">{{ section.settings.text }}</p>
    </div>

    <div class="gallery-grid">
      {% for block in section.blocks %}
        <div class="image-frame" {{ block.shopify_attributes }}>
          {% render 'asset-or-image',
            image: block.settings.image,
            fallback_asset: block.settings.fallback_asset,
            alt: block.settings.alt,
            sizes: '(max-width: 639px) 100vw, (max-width: 1099px) 50vw, 33vw',
            width: 1200
          %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "古民家ギャラリー",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "肩書き",
      "default": "Gallery"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "ギャラリー"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "本文",
      "default": "土間、客室、庭先、畑への道。古民家に流れる時間を、静かなまま並べています。"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "画像",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "フォールバック画像",
          "default": "kominka-hero-stay.webp"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "alt",
          "default": "古民家の写真"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "古民家ギャラリー"
    }
  ]
}
{% endschema %}
