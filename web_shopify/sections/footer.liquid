{% liquid
  assign footer_menu = linklists[settings.footer_menu]
%}

<footer class="footer" role="contentinfo">
  <div class="footer__inner shell">
    <div>
      <img
        src="{{ 'shikoku-botanica-logo-footer.png' | asset_url }}"
        alt="{{ settings.brand_name_ja | default: shop.name }}"
        class="footer__logo"
        width="240"
        height="400"
        loading="lazy"
      >
      <p class="eyebrow">{{ settings.brand_name_ja }}</p>
      <h2 class="footer__title">{{ settings.brand_name_ja }}</h2>
      <p>{{ settings.footer_lead }}</p>
    </div>

    <div>
      <p class="eyebrow">イヌトウキ</p>
      <p>生活習慣への向き合い方を大切にしながら、日々に取り入れやすい当帰商品をご案内します。</p>
      <p>{{ settings.brand_name_en }}</p>
    </div>

    <div>
      <p class="eyebrow">お問い合わせ</p>
      {% if settings.contact_email != blank %}
        <p>
          メール:
          <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
        </p>
      {% endif %}
      {% if settings.contact_phone != blank %}
        <p>
          電話:
          <a href="tel:{{ settings.contact_phone }}">{{ settings.contact_phone }}</a>
        </p>
      {% endif %}

      <nav class="footer__links" aria-label="フッターナビゲーション">
        {% liquid
          assign has_shipping_policy = false
          assign has_refund_policy = false
          assign has_privacy_policy = false
          assign has_terms_policy = false
          assign has_legal_notice = false

          for link in footer_menu.links
            if link.url == '/policies/shipping-policy'
              assign has_shipping_policy = true
            elsif link.url == '/policies/refund-policy'
              assign has_refund_policy = true
            elsif link.url == '/policies/privacy-policy'
              assign has_privacy_policy = true
            elsif link.url == '/pages/terms-of-service'
              assign has_terms_policy = true
            elsif link.url == '/policies/legal-notice'
              assign has_legal_notice = true
            endif
          endfor
        %}

        {% if footer_menu.links.size > 0 %}
          {% for link in footer_menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% endif %}
        {% unless has_shipping_policy %}<a href="/policies/shipping-policy">配送ポリシー</a>{% endunless %}
        {% unless has_refund_policy %}<a href="/policies/refund-policy">返金ポリシー</a>{% endunless %}
        {% unless has_privacy_policy %}<a href="/policies/privacy-policy">プライバシーポリシー</a>{% endunless %}
        {% unless has_terms_policy %}<a href="/pages/terms-of-service">利用規約</a>{% endunless %}
        {% unless has_legal_notice %}<a href="/policies/legal-notice">特定商取引法に基づく表記</a>{% endunless %}
      </nav>

      <div class="social-links">
        {% if settings.line_url != blank %}
          <a class="social-link" href="{{ settings.line_url }}" target="_blank" rel="noopener noreferrer">Line</a>
        {% endif %}
        {% if settings.facebook_url != blank %}
          <a class="social-link" href="{{ settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook</a>
        {% endif %}
        {% if settings.instagram_url != blank %}
          <a class="social-link" href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "フッター",
  "settings": []
}
{% endschema %}
