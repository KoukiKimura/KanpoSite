{% liquid
  assign selected_blog = blogs[section.settings.blog]
  assign article_limit = section.settings.article_limit
%}

<section class="section">
  <div class="shell">
    <div style="max-width: 720px; margin-bottom: 32px;">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="heading-serif section-heading">{{ section.settings.title }}</h2>
      {% if section.settings.text != blank %}
        <div class="section-body">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="blog-list">
      {% if selected_blog != blank and selected_blog.articles_count > 0 %}
        {% for article in selected_blog.articles limit: article_limit %}
          <article class="blog-list-item">
            <div class="blog-list-item__body">
              <p class="blog-list-item__date">{{ article.published_at | date: '%Y.%m.%d' }}</p>
              <h3 class="heading-serif blog-list-item__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              {% if article.excerpt != blank %}
                <p class="blog-list-item__excerpt">{{ article.excerpt | strip_html | truncate: 110 }}</p>
              {% endif %}
              {% if article.tags.size > 0 %}
                <div class="blog-tags">
                  {% for tag in article.tags %}
                    <a class="blog-tag" href="{{ selected_blog.url }}/tagged/{{ tag | handle }}">#{{ tag }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
            {% if article.image != blank %}
              <a class="blog-list-item__thumb image-frame" href="{{ article.url }}" aria-label="{{ article.title }}">
                {% render 'responsive-image',
                  image: article.image,
                  alt: article.title,
                  sizes: '(max-width: 639px) 96px, 140px',
                  width: 320
                %}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="blog-list-item">
            <div class="blog-list-item__body">
              <p class="blog-list-item__date">BLOG</p>
              <h3 class="heading-serif blog-list-item__title">BLOG記事のプレビュー</h3>
              <p class="blog-list-item__excerpt">ShopifyでBLOGを作成すると、最新記事がここに表示されます。</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "最新BLOG",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "肩書き",
      "default": "BLOG"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "BLOG"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "本文",
      "default": "畑や古民家、商品づくりの背景をBLOGから更新します。"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "BLOG"
    },
    {
      "type": "range",
      "id": "article_limit",
      "label": "表示件数",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "最新BLOG"
    }
  ]
}
{% endschema %}
