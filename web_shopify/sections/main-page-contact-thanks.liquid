<section class="section">
  <div class="shell contact-thanks-layout">
    <div class="card contact-panel">
      <p class="eyebrow">Thank you</p>
      <h1 class="heading-serif section-heading">お問い合わせありがとうございます</h1>
      <div class="section-body" style="margin-top: 20px;">
        <p>内容を確認の上、数日以内にご返信いたします。<br>返信にお時間をいただく場合がございますが、ご了承ください。</p>
      </div>
      <div style="margin-top: 32px;">
        <a class="button" href="{{ routes.root_url }}">トップページへ戻る</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "お問い合わせ受付完了"
}
{% endschema %}
